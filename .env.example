# ==========================================
# Rukshan Amodya Portfolio Environment Configuration
# ==========================================

# 1. Receiver Email (Where you want to receive inquiries)
CONTACT_RECEIVER_EMAIL="rukshanamodya@gmail.com"

# 2. SMTP Configuration (e.g. Gmail, Zoho, Brevo, SendGrid, Hostinger)
# For Gmail: Use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"

# 3. (Optional) Telegram Instant Notification Bot
# Get bot token from @BotFather and your user ID from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 4. (Optional) Discord Webhook Notification
DISCORD_WEBHOOK_URL=""
